PORT=5000
# Copy to .env and fill in real values — never commit them.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority
# Must match the existing DB on the cluster (case-sensitive: "studiospace" is rejected, code 13297)
DB_NAME=StudioSpace
# Must be IDENTICAL to JWT_SECRET in the client .env.local
JWT_SECRET=<same-value-as-client-jwt-secret>
# Comma separated list of allowed client origins
CLIENT_URL=http://localhost:3000
